{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://anzeimppqytonfxrnqxp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "changethegame",
      "version": "0.1.0",
      "title": "changethegame"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the changethegame profile of the signed-in user: name, headline, XP, level and wallet balances (Coins, $CTG, Credits, Biopoints).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "search_quests",
        "title": "Search quests",
        "description": "Search visible changethegame quests by keyword across title and description, optionally filtered by status or guild.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keyword to look for in quest titles and descriptions."
            },
            "status": {
              "type": "string",
              "enum": [
                "OPEN",
                "IN_PROGRESS",
                "COMPLETED",
                "OPEN_FOR_PROPOSALS",
                "ACTIVE",
                "IDEA"
              ],
              "description": "Restrict results to this quest status."
            },
            "guild_id": {
              "type": "string",
              "format": "uuid",
              "description": "Restrict results to quests owned by this guild."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Maximum number of quests to return."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_quest",
        "title": "Get quest detail",
        "description": "Fetch one quest with its subtasks, participants and recent updates. Use search_quests or list_my_quests first to get the quest id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "quest_id": {
              "type": "string",
              "format": "uuid",
              "description": "The quest id."
            }
          },
          "required": [
            "quest_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_quests",
        "title": "List my quests",
        "description": "List the quests the signed-in user created or participates in, most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum number of quests to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_guilds",
        "title": "List my guilds",
        "description": "List the guilds, networks and collectives the signed-in user is a member of, with their role in each.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Maximum number of guilds to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_tasks",
        "title": "List my tasks",
        "description": "List the signed-in user's open work: personal tasks plus quest subtasks assigned to them.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_done": {
              "type": "boolean",
              "default": false,
              "description": "Include tasks already marked as done."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "description": "Maximum number of items per list."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_personal_task",
        "title": "Create personal task",
        "description": "Create a private personal task on the signed-in user's changethegame to-do list.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short task title."
            },
            "description": {
              "type": "string",
              "maxLength": 2000,
              "description": "Optional task details."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "medium",
              "description": "Task priority."
            },
            "due_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Optional due date in YYYY-MM-DD format."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_personal_task",
        "title": "Update personal task",
        "description": "Update the status, priority or due date of one of the signed-in user's personal tasks.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "description": "The personal task id (from list_my_tasks)."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done"
              ],
              "description": "New status."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "New priority."
            },
            "due_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "New due date in YYYY-MM-DD format."
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
